OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=./data/vector_store
DOCS_PATH=./data/documents
TOP_K=4
# Cosine-similarity floor a retrieved chunk must clear before it's sent to the LLM.
# Tuned empirically: real correct matches scored ~0.50-0.60 with all-MiniLM-L6-v2,
# so 0.70 was rejecting good evidence. Re-tune if you swap corpus/model.
MIN_RETRIEVAL_SCORE=0.35
API_BASE_URL=http://localhost:8000
